# Copy to .env (gitignored) and fill in. Without any key the server runs in offline "practice" mode.

# Which provider serves AI: gemini | anthropic | practice (offline). Auto-detected from the keys below when unset.
PW_AI_PROVIDER=

# Google Gemini (AI Studio key)
GEMINI_API_KEY=
PW_GEMINI_MODEL_QUALITY=gemini-3.8-flash
PW_GEMINI_MODEL_FAST=gemini-3.5-flash-lite

# Anthropic Claude (optional alternative)
ANTHROPIC_API_KEY=
PW_MODEL_QUALITY=claude-opus-5-5
PW_MODEL_FAST=claude-haiku-5-5

# Server
PW_PORT=8787
PW_JWT_SECRET=change-me-dev-secret
